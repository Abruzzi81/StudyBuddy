{
    "openapi": "3.0.0",
    "info": {
        "title": "StudyBuddy API",
        "description": "API do zarządzania planem zajęć, zadaniami i ocenami w aplikacji StudyBuddy (Express.js + Knex + PostgreSQL).",
        "version": "1.0.0"
    },
    "servers": [
        {
            "url": "http://localhost:3002/api",
            "description": "Lokalny serwer deweloperski"
        }
    ],
    "paths": {
        "/auth/register": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Rejestracja nowego użytkownika",
                "description": "Tworzy konto użytkownika. Hasło musi mieć od 10 do 72 znaków.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "student@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "minLength": 10,
                                        "maxLength": 72,
                                        "example": "MojeHaslo123"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Użytkownik został utworzony",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "409": {
                        "description": "Adres e-mail jest już zarejestrowany"
                    },
                    "400": {
                        "description": "Nieprawidłowe dane"
                    }
                }
            }
        },
        "/auth/login": {
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Logowanie użytkownika",
                "description": "Loguje użytkownika i zwraca token JWT.",
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "email",
                                    "password"
                                ],
                                "properties": {
                                    "email": {
                                        "type": "string",
                                        "format": "email",
                                        "example": "student@example.com"
                                    },
                                    "password": {
                                        "type": "string",
                                        "example": "MojeHaslo123"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Logowanie zakończone sukcesem",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "properties": {
                                        "accessToken": {
                                            "type": "string",
                                            "description": "Token JWT"
                                        },
                                        "tokenType": {
                                            "type": "string",
                                            "example": "Bearer"
                                        },
                                        "expiresIn": {
                                            "type": "string",
                                            "example": "1h"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Nieprawidłowy e-mail lub hasło"
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Pobierz dane zalogowanego użytkownika",
                "description": "Zwraca dane użytkownika na podstawie tokenu JWT.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Dane zalogowanego użytkownika",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/User"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Brak lub nieprawidłowy token JWT"
                    },
                    "404": {
                        "description": "Nie znaleziono użytkownika"
                    }
                }
            }
        },
        "/subjects": {
            "get": {
                "summary": "Pobierz listę wszystkich przedmiotów",
                "tags": [
                    "Subjects"
                ],
                "responses": {
                    "200": {
                        "description": "Sukces. Zwraca tablicę przedmiotów.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "data",
                                        "pagination"
                                    ],
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Subject"
                                            }
                                        },
                                        "pagination": {
                                            "$ref": "#/components/schemas/Pagination"
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "500": {
                        "description": "Błąd serwera."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "parameters": [
                    {
                        "in": "query",
                        "name": "page",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        },
                        "description": "Numer strony"
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 20,
                            "maximum": 100
                        },
                        "description": "Liczba rekordów na stronie (maks. 100)"
                    }
                ],
                "description": "Odpowiedź zawiera pola data oraz pagination (page, limit, total, totalPages)."
            },
            "post": {
                "summary": "Dodaj nowy przedmiot",
                "tags": [
                    "Subjects"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "name"
                                ],
                                "properties": {
                                    "name": {
                                        "type": "string",
                                        "maxLength": 100,
                                        "example": "Matematyka Dyskretna"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Przedmiot został pomyślnie utworzony.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Subject"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Błąd walidacji danych (np. brak nazwy)."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/tasks": {
            "get": {
                "summary": "Pobierz listę wszystkich zadań",
                "tags": [
                    "Tasks"
                ],
                "parameters": [
                    {
                        "in": "query",
                        "name": "status",
                        "schema": {
                            "type": "string",
                            "enum": [
                                "PENDING",
                                "IN_PROGRESS",
                                "COMPLETED",
                                "CANCELED"
                            ]
                        },
                        "description": "Filtruj zadania po statusie"
                    },
                    {
                        "in": "query",
                        "name": "subject_id",
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "description": "Filtruj zadania po ID przedmiotu"
                    },
                    {
                        "in": "query",
                        "name": "page",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        },
                        "description": "Numer strony"
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 20,
                            "maximum": 100
                        },
                        "description": "Liczba rekordów na stronie (maks. 100)"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sukces. Zwraca listę zadań.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "data",
                                        "pagination"
                                    ],
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Task"
                                            }
                                        },
                                        "pagination": {
                                            "$ref": "#/components/schemas/Pagination"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "description": "Odpowiedź zawiera pola data oraz pagination (page, limit, total, totalPages)."
            },
            "post": {
                "summary": "Utwórz nowe zadanie powiązane z przedmiotem",
                "tags": [
                    "Tasks"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "title",
                                    "subject_id"
                                ],
                                "properties": {
                                    "subject_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "title": {
                                        "type": "string",
                                        "maxLength": 150,
                                        "example": "Zadanie domowe z list"
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Napisać implementację listy dwukierunkowej",
                                        "nullable": true
                                    },
                                    "due_date": {
                                        "type": "string",
                                        "format": "date-time",
                                        "example": "2026-11-20T18:00:00.000Z",
                                        "nullable": true
                                    },
                                    "type": {
                                        "type": "string",
                                        "enum": [
                                            "HOMEWORK",
                                            "TEST",
                                            "OTHER"
                                        ],
                                        "default": "OTHER"
                                    },
                                    "status": {
                                        "type": "string",
                                        "enum": [
                                            "PENDING",
                                            "IN_PROGRESS",
                                            "COMPLETED",
                                            "CANCELED"
                                        ],
                                        "default": "PENDING"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Zadanie zostało utworzone.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Task"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Błąd walidacji (np. nieistniejący subject_id)."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/tasks/{id}": {
            "parameters": [
                {
                    "in": "path",
                    "name": "id",
                    "required": true,
                    "schema": {
                        "type": "integer"
                    },
                    "description": "ID zadania"
                }
            ],
            "get": {
                "summary": "Pobierz szczegóły konkretnego zadania",
                "tags": [
                    "Tasks"
                ],
                "responses": {
                    "200": {
                        "description": "Znaleziono zadanie.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Task"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Zadanie nie zostało znalezione."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "patch": {
                "summary": "Częściowo zaktualizuj zadanie",
                "tags": [
                    "Tasks"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateTask"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Zadanie zaktualizowane.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Task"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Nieprawidłowe dane."
                    },
                    "404": {
                        "description": "Nie znaleziono zadania lub przedmiotu."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/grades": {
            "get": {
                "summary": "Pobierz listę wszystkich ocen",
                "tags": [
                    "Grades"
                ],
                "parameters": [
                    {
                        "in": "query",
                        "name": "subject_id",
                        "schema": {
                            "type": "integer"
                        },
                        "description": "Filtruj oceny po ID przedmiotu"
                    },
                    {
                        "in": "query",
                        "name": "limit",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 100,
                            "default": 20
                        },
                        "description": "Maksymalna liczba zwracanych ocen"
                    },
                    {
                        "in": "query",
                        "name": "page",
                        "schema": {
                            "type": "integer",
                            "minimum": 1,
                            "default": 1
                        },
                        "description": "Numer strony"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Sukces. Zwraca listę ocen.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "object",
                                    "required": [
                                        "data",
                                        "pagination"
                                    ],
                                    "properties": {
                                        "data": {
                                            "type": "array",
                                            "items": {
                                                "$ref": "#/components/schemas/Grade"
                                            }
                                        },
                                        "pagination": {
                                            "$ref": "#/components/schemas/Pagination"
                                        }
                                    }
                                }
                            }
                        }
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "description": "Odpowiedź zawiera pola data oraz pagination (page, limit, total, totalPages)."
            },
            "post": {
                "summary": "Dodaj nową ocenę",
                "tags": [
                    "Grades"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "type": "object",
                                "required": [
                                    "subject_id",
                                    "grade"
                                ],
                                "properties": {
                                    "subject_id": {
                                        "type": "integer",
                                        "example": 1
                                    },
                                    "grade": {
                                        "type": "number",
                                        "format": "float",
                                        "example": 4.5
                                    },
                                    "weight": {
                                        "type": "number",
                                        "format": "float",
                                        "default": 1,
                                        "example": 2
                                    },
                                    "description": {
                                        "type": "string",
                                        "example": "Kolokwium nr 1"
                                    },
                                    "grade_date": {
                                        "type": "string",
                                        "format": "date",
                                        "example": "2026-11-14"
                                    }
                                }
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Ocena została dodana.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Grade"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Błąd walidacji (np. nieistniejący subject_id)."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/tasks/summary": {
            "get": {
                "summary": "Pobierz podsumowanie zadań użytkownika",
                "description": "Zwraca liczbę wszystkich zadań oraz liczbę zadań w poszczególnych statusach.",
                "tags": [
                    "Tasks"
                ],
                "responses": {
                    "200": {
                        "description": "Statystyki zadań.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/TaskSummary"
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Brak uwierzytelnienia."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/tasks/{id}/cancel": {
            "patch": {
                "summary": "Anuluj zadanie",
                "tags": [
                    "Tasks"
                ],
                "parameters": [
                    {
                        "in": "path",
                        "name": "id",
                        "required": true,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Zadanie anulowane.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Task"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Nie znaleziono zadania."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/subjects/{id}": {
            "parameters": [
                {
                    "in": "path",
                    "name": "id",
                    "required": true,
                    "schema": {
                        "type": "integer",
                        "minimum": 1
                    }
                }
            ],
            "patch": {
                "summary": "Zaktualizuj przedmiot",
                "tags": [
                    "Subjects"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateSubject"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Przedmiot zaktualizowany.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Subject"
                                }
                            }
                        }
                    },
                    "400": {
                        "description": "Nieprawidłowe dane."
                    },
                    "404": {
                        "description": "Nie znaleziono przedmiotu."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "get": {
                "summary": "Pobierz przedmiot",
                "tags": [
                    "Subjects"
                ],
                "responses": {
                    "200": {
                        "description": "Szczegóły przedmiotu.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Subject"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Nie znaleziono przedmiotu."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            },
            "delete": {
                "summary": "Usuń przedmiot",
                "tags": [
                    "Subjects"
                ],
                "responses": {
                    "200": {
                        "description": "Usunięty przedmiot.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/Subject"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Nie znaleziono przedmiotu."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/grades/average": {
            "get": {
                "summary": "Oblicz średnią ważoną ocen",
                "description": "Bez subject_id zwraca średnią ze wszystkich ocen użytkownika; z subject_id ogranicza obliczenie do wskazanego przedmiotu.",
                "tags": [
                    "Grades"
                ],
                "parameters": [
                    {
                        "in": "query",
                        "name": "subject_id",
                        "required": false,
                        "schema": {
                            "type": "integer",
                            "minimum": 1
                        },
                        "description": "Opcjonalne ID przedmiotu."
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Średnia ważona i liczba ocen.",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "$ref": "#/components/schemas/GradeAverage"
                                }
                            }
                        }
                    },
                    "404": {
                        "description": "Nie znaleziono przedmiotu."
                    }
                },
                "security": [
                    {
                        "bearerAuth": []
                    }
                ]
            }
        },
        "/admin/users": {
            "get": {
                "tags": [
                    "Admin"
                ],
                "summary": "Lista użytkowników (ADMIN)",
                "description": "Endpoint dostępny wyłącznie dla użytkowników z rolą ADMIN. Nie zwraca hashy haseł.",
                "security": [
                    {
                        "bearerAuth": []
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Lista użytkowników",
                        "content": {
                            "application/json": {
                                "schema": {
                                    "type": "array",
                                    "items": {
                                        "$ref": "#/components/schemas/User"
                                    }
                                }
                            }
                        }
                    },
                    "401": {
                        "description": "Brak lub nieprawidłowy token JWT"
                    },
                    "403": {
                        "description": "Wymagana rola ADMIN"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Subject": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "name": {
                        "type": "string",
                        "example": "Matematyka"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Task": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "subject_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "title": {
                        "type": "string",
                        "example": "Sprawdzian z baz danych"
                    },
                    "description": {
                        "type": "string",
                        "example": "Powtórzyć relacje i klucze obce"
                    },
                    "due_date": {
                        "type": "string",
                        "format": "date-time",
                        "example": "2026-11-18T10:00:00.000Z"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "HOMEWORK",
                            "TEST",
                            "OTHER"
                        ],
                        "example": "TEST"
                    },
                    "status": {
                        "type": "string",
                        "enum": [
                            "PENDING",
                            "IN_PROGRESS",
                            "COMPLETED",
                            "CANCELED"
                        ],
                        "example": "PENDING"
                    },
                    "createdAt": {
                        "type": "string",
                        "format": "date-time"
                    }
                }
            },
            "Grade": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "subject_id": {
                        "type": "integer",
                        "example": 1
                    },
                    "grade": {
                        "type": "number",
                        "format": "float",
                        "example": 5
                    },
                    "weight": {
                        "type": "number",
                        "format": "float",
